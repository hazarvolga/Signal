// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logoUrl     String?
  address     String?
  timezone    String   @default("UTC")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  contacts    Contact[]
  lists       List[]
  segments    Segment[]
  campaigns   Campaign[]
  templates   Template[]
  flows       Flow[]
  forms       Form[]
  domains     Domain[]
  apiKeys     ApiKey[]
  auditLogs   AuditLog[]
  customFieldDefinitions CustomFieldDefinition[]
  brands      Brand[]
  integrations Integration[]
  products    Product[]
  webhooks    Webhook[]
  revenue     Revenue[]
  workflowTemplates WorkflowTemplate[]
  roles       Role[]
  consentLogs ConsentLog[]
  dataRequests DataRequest[]

  // SSO Config
  ssoEnabled      Boolean  @default(false)
  ssoDomain       String?
  ssoClientId     String?
  ssoClientSecret String?
  ssoIssuer       String?
}

model WorkflowTemplate {
  id             String       @id @default(cuid())
  name           String
  description    String?
  category       String       // ONBOARDING, ENGAGEMENT, REVENUE, SUPPORT, EVENT_DRIVEN, AI_POWERED
  nodes          String       @default("[]") // JSON string for React Flow nodes
  edges          String       @default("[]") // JSON string for React Flow edges
  organizationId String?      // Optional: if null, it's a system template
  organization   Organization? @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Brand {
  id             String       @id @default(cuid())
  name           String
  logoUrl        String?
  primaryColor   String?
  secondaryColor String?
  fontFamily     String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Product {
  id             String       @id @default(cuid())
  externalId     String?      // ID from Shopify/Woo
  name           String
  description    String?
  price          Float
  currency       String       @default("USD")
  imageUrl       String?
  productUrl     String?
  source         String       @default("CUSTOM") // SHOPIFY, WOOCOMMERCE, CUSTOM
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Revenue {
  id             String       @id @default(cuid())
  amount         Float
  currency       String       @default("USD")
  campaignId     String?
  campaign       Campaign?    @relation(fields: [campaignId], references: [id])
  flowId         String?
  flow           Flow?        @relation(fields: [flowId], references: [id])
  contactId      String
  contact        Contact      @relation(fields: [contactId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  timestamp      DateTime     @default(now())
}

model Integration {
  id             String       @id @default(cuid())
  type           String       // SHOPIFY, WOOCOMMERCE, ZAPIER, HUBSPOT
  status         String       @default("DISCONNECTED") // CONNECTED, DISCONNECTED, ERROR
  config         String       @default("{}") // JSON string for API keys, etc.
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Webhook {
  id             String       @id @default(cuid())
  url            String
  events         String       @default("[]") // JSON string of event types
  secret         String?
  isActive       Boolean      @default(true)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  name           String
  role           String       @default("VIEWER") // OWNER, ADMIN, EDITOR, ANALYST, VIEWER
  status         String       @default("ACTIVE") // PENDING, ACTIVE
  roleId         String?
  customRole     Role?        @relation(fields: [roleId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  
  // SSO & MFA
  ssoId          String?      @unique
  ssoProvider    String?
  mfaEnabled     Boolean      @default(false)
  lastLoginAt    DateTime?
  lastLoginIp    String?
  lastLoginUserAgent String?
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Role {
  id             String       @id @default(cuid())
  name           String
  permissions    String       @default("[]") // JSON string of permission keys
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  users          User[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model ConsentLog {
  id             String       @id @default(cuid())
  contactId      String
  contact        Contact      @relation(fields: [contactId], references: [id])
  action         String       // SUBSCRIBE, UNSUBSCRIBE, PREFERENCE_UPDATE
  source         String       // FORM, PREFERENCE_CENTER, API, MANUAL
  ipAddress      String?
  userAgent      String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  timestamp      DateTime     @default(now())
}

model DataRequest {
  id             String       @id @default(cuid())
  contactId      String
  contact        Contact      @relation(fields: [contactId], references: [id])
  type           String       // EXPORT, DELETE
  status         String       @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Contact {
  id             String       @id @default(cuid())
  email          String
  firstName      String?
  lastName       String?
  phone          String?
  status         String       @default("SUBSCRIBED") // SUBSCRIBED, UNSUBSCRIBED, BOUNCED, COMPLAINED, CLEANED
  source         String?
  engagementScore Int         @default(0)
  customFields   String       @default("{}") // JSON string for SQLite
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tags           Tag[]
  listMemberships ListMembership[]
  events         Event[]
  revenue        Revenue[]
  consentLogs    ConsentLog[]
  dataRequests   DataRequest[]

  @@unique([email, organizationId])
}

model Tag {
  id        String    @id @default(cuid())
  name      String
  contacts  Contact[]
}

model List {
  id             String       @id @default(cuid())
  name           String
  description    String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  memberships    ListMembership[]
}

model ListMembership {
  contactId String
  listId    String
  contact   Contact @relation(fields: [contactId], references: [id])
  list      List    @relation(fields: [listId], references: [id])

  @@id([contactId, listId])
}

model Segment {
  id             String       @id @default(cuid())
  name           String
  rules          String       @default("[]") // JSON string of rule objects
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Campaign {
  id             String       @id @default(cuid())
  name           String
  subject        String
  previewText    String?
  fromName       String
  fromEmail      String
  replyTo        String?
  content        String       @default("") // HTML or Block JSON
  subjectB       String?
  contentB       String?
  testPercentage Int?         @default(20)
  testDuration   Int?         @default(4)
  winnerCriteria String?      @default("OPEN_RATE")
  type           String       @default("REGULAR") // REGULAR, AB, AUTOMATED, TRANSACTIONAL
  status         String       @default("DRAFT") // DRAFT, SCHEDULED, SENDING, SENT, ARCHIVED, IN_REVIEW
  timezone       String       @default("UTC")
  scheduledAt    DateTime?
  sentAt         DateTime?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  templateId     String?
  template       Template?    @relation(fields: [templateId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  events         Event[]
  revenue        Revenue[]
  approvals      ApprovalRequest[]
  variations     CampaignVariation[]
}

model CampaignVariation {
  id             String   @id @default(cuid())
  campaignId     String
  campaign       Campaign @relation(fields: [campaignId], references: [id])
  subject        String?
  content        String?
  fromName       String?
  fromEmail      String?
  previewText    String?
  isWinner       Boolean  @default(false)
  weight         Float    @default(1.0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  events         Event[]
}

model Template {
  id             String       @id @default(cuid())
  name           String
  content        String
  category       String?
  status         String       @default("DRAFT") // DRAFT, IN_REVIEW, APPROVED
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  campaigns      Campaign[]
  approvals      ApprovalRequest[]
}

model ApprovalRequest {
  id             String       @id @default(cuid())
  templateId     String?
  template       Template?    @relation(fields: [templateId], references: [id])
  campaignId     String?
  campaign       Campaign?    @relation(fields: [campaignId], references: [id])
  requesterId    String
  status         String       @default("PENDING") // PENDING, APPROVED, REJECTED
  comments       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Event {
  id             String   @id @default(cuid())
  type           String   // SENT, OPEN, CLICK, BOUNCE, COMPLAINT, UNSUBSCRIBE
  metadata       String   @default("{}") // JSON string for link URLs, etc.
  campaignId     String?
  campaign       Campaign? @relation(fields: [campaignId], references: [id])
  variationId    String?
  variation      CampaignVariation? @relation(fields: [variationId], references: [id])
  contactId      String
  contact        Contact  @relation(fields: [contactId], references: [id])
  timestamp      DateTime @default(now())
}

model Flow {
  id             String       @id @default(cuid())
  name           String
  status         String       @default("DRAFT") // DRAFT, ACTIVE, PAUSED
  nodes          String       @default("[]") // JSON string for React Flow nodes
  edges          String       @default("[]") // JSON string for React Flow edges
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  revenue        Revenue[]
}

model Form {
  id             String       @id @default(cuid())
  name           String
  config         String       @default("{}") // JSON string for form fields/styles
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Domain {
  id             String       @id @default(cuid())
  domain         String
  isVerified     Boolean      @default(false)
  spfRecord      String?
  dkimRecord     String?
  dmarcRecord    String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model ApiKey {
  id             String       @id @default(cuid())
  name           String
  key            String       @unique
  scopes         String       @default("[]") // JSON string of scopes
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  lastUsedAt     DateTime?
}

model AuditLog {
  id             String       @id @default(cuid())
  action         String
  entityType     String
  entityId       String
  userId         String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  timestamp      DateTime     @default(now())
}

model CustomFieldDefinition {
  id             String       @id @default(cuid())
  name           String
  key            String
  type           String       @default("TEXT") // TEXT, NUMBER, DATE, BOOLEAN
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([key, organizationId])
}
