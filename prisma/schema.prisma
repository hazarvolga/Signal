// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  address   String?
  timezone  String   @default("UTC")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                  User[]
  contacts               Contact[]
  lists                  List[]
  segments               Segment[]
  campaigns              Campaign[]
  templates              Template[]
  flows                  Flow[]
  forms                  Form[]
  domains                Domain[]
  apiKeys                ApiKey[]
  auditLogs              AuditLog[]
  customFieldDefinitions CustomFieldDefinition[]
  brands                 Brand[]
  integrations           Integration[]
  products               Product[]
  webhooks               Webhook[]
  revenue                Revenue[]
  workflowTemplates      WorkflowTemplate[]
  roles                  Role[]
  consentLogs            ConsentLog[]
  dataRequests           DataRequest[]
  assets                 Asset[]
  validationLogs         ValidationLog[]
  bulkValidationJobs     BulkValidationJob[]
  behavioralEvents       BehavioralEvent[]
  campaignDispatches     CampaignDispatch[]
  recipientDeliveries    RecipientDelivery[]
  providerEvents         ProviderEvent[]
  trackingEventReceipts  TrackingEventReceipt[]
  suppressions           Suppression[]
  flowExecutions         FlowExecution[]
  flowNodeExecutions     FlowNodeExecution[]
  tags                   Tag[]
  aiUsageLedger          AiUsageLedger[]

  // SSO Config
  ssoEnabled      Boolean @default(false)
  ssoDomain       String?
  ssoClientId     String?
  ssoClientSecret String?
  ssoIssuer       String?
  ssoEntryPoint   String?
  ssoCert         String?
}

model AiUsageLedger {
  id                  String       @id @default(cuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id])
  feature             String
  provider            String
  model               String
  pricingVersion      String
  inputTokens         Int          @default(0)
  outputTokens        Int          @default(0)
  totalTokens         Int          @default(0)
  imageCount          Int          @default(0)
  estimatedCostMicros BigInt       @default(0)
  reservedCostMicros  BigInt       @default(0)
  latencyMs           Int?
  status              String       @default("STARTED")
  errorCode           String?
  createdAt           DateTime     @default(now())
  completedAt         DateTime?

  @@index([organizationId, createdAt])
  @@index([organizationId, status, createdAt])
}

model WorkflowTemplate {
  id             String        @id @default(cuid())
  name           String
  description    String?
  category       String // ONBOARDING, ENGAGEMENT, REVENUE, SUPPORT, EVENT_DRIVEN, AI_POWERED
  nodes          String        @default("[]") // JSON string for React Flow nodes
  edges          String        @default("[]") // JSON string for React Flow edges
  organizationId String? // Optional: if null, it's a system template
  organization   Organization? @relation(fields: [organizationId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Brand {
  id             String       @id @default(cuid())
  name           String
  logoUrl        String?
  primaryColor   String?
  secondaryColor String?
  fontFamily     String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Product {
  id             String       @id @default(cuid())
  externalId     String? // ID from Shopify/Woo
  name           String
  description    String?
  price          Float
  currency       String       @default("USD")
  imageUrl       String?
  productUrl     String?
  source         String       @default("CUSTOM") // SHOPIFY, WOOCOMMERCE, CUSTOM
  stock          Int          @default(0)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model WebhookLog {
  id             String   @id @default(cuid())
  externalId     String?  @unique
  source         String // e.g., "SHOPIFY"
  topic          String // e.g., "products/update"
  payload        String   @db.Text
  processed      Boolean  @default(false)
  organizationId String?
  createdAt      DateTime @default(now())
}

model Revenue {
  id             String       @id @default(cuid())
  amount         Float
  currency       String       @default("USD")
  campaignId     String?
  campaign       Campaign?    @relation(fields: [campaignId], references: [id])
  flowId         String?
  flow           Flow?        @relation(fields: [flowId], references: [id])
  contactId      String
  contact        Contact      @relation(fields: [contactId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  timestamp      DateTime     @default(now())

  @@index([campaignId])
  @@index([contactId])
}

model Integration {
  id             String       @id @default(cuid())
  type           String // SHOPIFY, WOOCOMMERCE, ZAPIER, HUBSPOT
  status         String       @default("DISCONNECTED") // CONNECTED, DISCONNECTED, ERROR
  config         String       @default("{}") // JSON string for API keys, etc.
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Webhook {
  id             String       @id @default(cuid())
  url            String
  events         String       @default("[]") // JSON string of event types
  secret         String?
  isActive       Boolean      @default(true)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  name           String
  passwordHash   String?
  role           String       @default("VIEWER") // OWNER, ADMIN, EDITOR, ANALYST, VIEWER
  status         String       @default("ACTIVE") // PENDING, ACTIVE
  roleId         String?
  customRole     Role?        @relation(fields: [roleId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // SSO & MFA
  ssoId              String?   @unique
  ssoProvider        String?
  mfaEnabled         Boolean   @default(false)
  lastLoginAt        DateTime?
  lastLoginIp        String?
  lastLoginUserAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id             String       @id @default(cuid())
  name           String
  permissions    String       @default("[]") // JSON string of permission keys
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  users          User[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model ConsentLog {
  id                 String       @id @default(cuid())
  contactId          String
  contact            Contact      @relation(fields: [contactId], references: [id])
  action             String // SUBSCRIBE, UNSUBSCRIBE, PREFERENCE_UPDATE
  source             String // FORM, PREFERENCE_CENTER, API, MANUAL
  ipAddress          String?
  userAgent          String?
  consentTextVersion String?
  purpose            String?
  lawfulBasis        String?
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id])
  timestamp          DateTime     @default(now())
}

model DataRequest {
  id             String       @id @default(cuid())
  contactId      String
  contact        Contact      @relation(fields: [contactId], references: [id])
  type           String // EXPORT, DELETE
  status         String       @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  resultUrl      String?
  error          String?
  completedAt    DateTime?
  expiresAt      DateTime?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Contact {
  @@index([organizationId, createdAt, id])
  id              String  @id @default(cuid())
  email           String
  firstName       String?
  lastName        String?
  phone           String?
  status          String  @default("SUBSCRIBED") // SUBSCRIBED, UNSUBSCRIBED, BOUNCED, COMPLAINED, CLEANED
  source          String?
  engagementScore Int     @default(0)
  customFields    String  @default("{}") // JSON string for SQLite

  // Channel Preferences
  emailConsent    Boolean @default(false)
  smsConsent      Boolean @default(false)
  whatsappConsent Boolean @default(false)
  preferenceToken String? @unique // For public preference center access

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tags                Tag[]
  segments            Segment[]
  listMemberships     ListMembership[]
  events              Event[]
  behavioralEvents    BehavioralEvent[]
  revenue             Revenue[]
  consentLogs         ConsentLog[]
  dataRequests        DataRequest[]
  engagement          EngagementEvent[]
  notifications       Notification[]
  campaignAudiences   CampaignAudience[]
  recipientDeliveries RecipientDelivery[]
  suppressions        Suppression[]
  flowExecutions      FlowExecution[]

  @@unique([email, organizationId])
}

model Notification {
  id         String    @id @default(cuid())
  title      String
  body       String
  link       String?
  isRead     Boolean   @default(false)
  contactId  String
  contact    Contact   @relation(fields: [contactId], references: [id])
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id])
  createdAt  DateTime  @default(now())
}

model Tag {
  id             String        @id @default(cuid())
  name           String
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  contacts       Contact[]

  @@unique([name, organizationId])
  @@index([organizationId])
}

model List {
  id             String       @id @default(cuid())
  name           String
  description    String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  memberships ListMembership[]
}

model ListMembership {
  contactId String
  listId    String
  contact   Contact @relation(fields: [contactId], references: [id])
  list      List    @relation(fields: [listId], references: [id])

  @@id([contactId, listId])
}

model Segment {
  id             String       @id @default(cuid())
  name           String
  rules          String       @default("[]") // JSON string of rule objects
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  contactCount   Int          @default(0)
  contacts       Contact[]
}

model Campaign {
  @@index([organizationId, createdAt, id])
  id                String             @id @default(cuid())
  name              String
  subject           String
  previewText       String?
  fromName          String
  fromEmail         String
  replyTo           String?
  content           String             @default("") // HTML or Block JSON
  channel           String             @default("EMAIL") // EMAIL, SMS, WHATSAPP
  subjectB          String?
  contentB          String?
  testPercentage    Int?               @default(20)
  testDuration      Int?               @default(4)
  winnerCriteria    String?            @default("OPEN_RATE")
  type              String             @default("REGULAR") // REGULAR, AB, AUTOMATED, TRANSACTIONAL
  status            String             @default("DRAFT") // DRAFT, SCHEDULED, SENDING, SENT, ARCHIVED, IN_REVIEW
  timezone          String             @default("UTC")
  perUserTimezone   Boolean            @default(false)
  scheduledAt       DateTime?
  sentAt            DateTime?
  abTestStartedAt   DateTime?
  abFinalizedAt     DateTime?
  abTestStatus      String?
  winnerVariationId String?
  winnerVariation   CampaignVariation? @relation("CampaignWinnerVariation", fields: [winnerVariationId], references: [id], onDelete: SetNull)
  organizationId    String
  organization      Organization       @relation(fields: [organizationId], references: [id])
  templateId        String?
  template          Template?          @relation(fields: [templateId], references: [id])
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  events        Event[]
  revenue       Revenue[]
  approvals     ApprovalRequest[]
  variations    CampaignVariation[]
  engagement    EngagementEvent[]
  notifications Notification[]
  audiences     CampaignAudience[]
  dispatches    CampaignDispatch[]

  @@index([scheduledAt])
  @@index([status])
}

model CampaignAudience {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId  String
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([campaignId, contactId])
  @@index([contactId])
}

model CampaignDispatch {
  fanoutCursor      String?
  id                String              @id @default(cuid())
  campaignId        String
  campaign          Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  organizationId    String
  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  idempotencyKey    String              @unique
  status            String              @default("QUEUED") // QUEUED, PROCESSING, ACCEPTED, PARTIAL, FAILED
  phase             String              @default("FULL") // FULL, TEST, WINNER
  winnerVariationId String?
  winnerVariation   CampaignVariation?  @relation("DispatchWinnerVariation", fields: [winnerVariationId], references: [id], onDelete: SetNull)
  requestedById     String?
  totalRecipients   Int                 @default(0)
  acceptedCount     Int                 @default(0)
  deliveredCount    Int                 @default(0)
  failedCount       Int                 @default(0)
  suppressedCount   Int                 @default(0)
  lastError         String?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deliveries        RecipientDelivery[]

  @@index([campaignId, status])
  @@index([campaignId, phase])
  @@index([organizationId, status])
}

model RecipientDelivery {
  id                    String                 @id @default(cuid())
  dispatchId            String
  dispatch              CampaignDispatch       @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  contactId             String
  contact               Contact                @relation(fields: [contactId], references: [id], onDelete: Restrict)
  organizationId        String
  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email                 String
  status                String                 @default("PENDING") // PENDING, PROCESSING, RETRY, ACCEPTED, DELIVERED, BOUNCED, COMPLAINED, SUPPRESSED, FAILED
  provider              String?
  providerMessageId     String?
  attempts              Int                    @default(0)
  lastError             String?
  acceptedAt            DateTime?
  deliveredAt           DateTime?
  failedAt              DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  providerEvents        ProviderEvent[]
  trackingEventReceipts TrackingEventReceipt[]
  variationId           String?
  variation             CampaignVariation?     @relation(fields: [variationId], references: [id], onDelete: SetNull)

  @@unique([dispatchId, contactId])
  @@unique([provider, providerMessageId])
  @@index([dispatchId, status, id])
  @@index([organizationId, status])
  @@index([email])
  @@index([variationId])
}

model ProviderEvent {
  id                  String            @id @default(cuid())
  provider            String
  eventId             String
  messageId           String
  type                String // DELIVERED, BOUNCED, COMPLAINED, REJECTED
  payloadHash         String
  payload             String            @db.Text
  occurredAt          DateTime
  processedAt         DateTime          @default(now())
  organizationId      String
  organization        Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipientDeliveryId String
  recipientDelivery   RecipientDelivery @relation(fields: [recipientDeliveryId], references: [id], onDelete: Cascade)

  @@unique([provider, eventId])
  @@index([provider, messageId])
  @@index([organizationId, type])
}

model TrackingEventReceipt {
  id                  String            @id @default(cuid())
  tokenId             String            @unique
  kind                String // OPEN, CLICK
  destination         String?
  occurredAt          DateTime          @default(now())
  organizationId      String
  organization        Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipientDeliveryId String
  recipientDelivery   RecipientDelivery @relation(fields: [recipientDeliveryId], references: [id], onDelete: Cascade)

  @@index([organizationId, kind, occurredAt])
  @@index([recipientDeliveryId, kind])
}

model Suppression {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactId       String?
  contact         Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  email           String
  reason          String // HARD_BOUNCE, COMPLAINT, MANUAL, UNSUBSCRIBE
  source          String
  providerEventId String?
  active          Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([organizationId, email])
  @@index([organizationId, active])
}

model CampaignVariation {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id])
  subject     String?
  content     String?
  fromName    String?
  fromEmail   String?
  previewText String?
  isWinner    Boolean  @default(false)
  weight      Float    @default(1.0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  events              Event[]
  recipientDeliveries RecipientDelivery[]
  wonCampaigns        Campaign[]          @relation("CampaignWinnerVariation")
  winnerDispatches    CampaignDispatch[]  @relation("DispatchWinnerVariation")
}

model Template {
  id             String       @id @default(cuid())
  name           String
  content        String
  category       String?
  status         String       @default("DRAFT") // DRAFT, IN_REVIEW, APPROVED
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  campaigns Campaign[]
  approvals ApprovalRequest[]
}

model ApprovalRequest {
  id          String    @id @default(cuid())
  templateId  String?
  template    Template? @relation(fields: [templateId], references: [id])
  campaignId  String?
  campaign    Campaign? @relation(fields: [campaignId], references: [id])
  requesterId String
  status      String    @default("PENDING") // PENDING, APPROVED, REJECTED
  comments    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Event {
  id          String             @id @default(cuid())
  type        String // SENT, OPEN, CLICK, BOUNCE, COMPLAINT, UNSUBSCRIBE, CUSTOM
  name        String? // For CUSTOM events (e.g., "PRODUCT_VIEWED", "CART_ABANDONED")
  metadata    String             @default("{}") // JSON string for link URLs, product IDs, etc.
  campaignId  String?
  campaign    Campaign?          @relation(fields: [campaignId], references: [id])
  variationId String?
  variation   CampaignVariation? @relation(fields: [variationId], references: [id])
  contactId   String
  contact     Contact            @relation(fields: [contactId], references: [id])
  timestamp   DateTime           @default(now())

  @@index([contactId])
  @@index([campaignId])
  @@index([campaignId, variationId, type])
  @@index([timestamp])
}

model BehavioralEvent {
  id             String       @id @default(cuid())
  name           String // e.g., "PRODUCT_VIEWED", "CART_ABANDONED", "CHECKOUT_STARTED"
  properties     String       @default("{}") // JSON string for event properties (price, product_id, etc.)
  contactId      String
  contact        Contact      @relation(fields: [contactId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  timestamp      DateTime     @default(now())

  @@index([contactId])
  @@index([timestamp])
}

model EngagementEvent {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  contactId  String?
  contact    Contact? @relation(fields: [contactId], references: [id])
  type       String // 'scroll', 'read_time', 'click'
  value      Float // scroll percentage or time in seconds
  sectionId  String? // ID of the section being read
  metadata   String? // Extra JSON data
  timestamp  DateTime @default(now())

  @@index([campaignId])
}

model Flow {
  id             String       @id @default(cuid())
  name           String
  status         String       @default("DRAFT") // DRAFT, ACTIVE, PAUSED
  nodes          String       @default("[]") // JSON string for React Flow nodes
  edges          String       @default("[]") // JSON string for React Flow edges
  scheduledAt    DateTime?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  revenue    Revenue[]
  executions FlowExecution[]
}

model FlowExecution {
  id             String              @id @default(cuid())
  flowId         String
  flow           Flow                @relation(fields: [flowId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactId      String
  contact        Contact             @relation(fields: [contactId], references: [id], onDelete: Restrict)
  triggerEventId String
  triggerType    String
  triggerName    String?
  triggerNodeId  String
  idempotencyKey String              @unique
  status         String              @default("QUEUED") // QUEUED, RUNNING, WAITING, COMPLETED, FAILED, CANCELLED
  currentNodeId  String?
  stepCount      Int                 @default(0)
  maxSteps       Int                 @default(100)
  context        String              @default("{}") @db.Text
  lastError      String?
  resumeAt       DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  nodeExecutions FlowNodeExecution[]

  @@unique([flowId, contactId, triggerEventId])
  @@index([organizationId, status])
  @@index([flowId, status])
  @@index([status, resumeAt])
}

model FlowNodeExecution {
  id                 String        @id @default(cuid())
  executionId        String
  execution          FlowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  organizationId     String
  organization       Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  nodeId             String
  nodeType           String
  status             String        @default("PENDING") // PENDING, RUNNING, WAITING, RETRY, COMPLETED, FAILED, SKIPPED
  attempts           Int           @default(0)
  maxAttempts        Int           @default(3)
  timeoutAt          DateTime?
  resumeAt           DateTime?
  output             String?       @db.Text
  lastError          String?
  actionCampaignId   String?
  campaignDispatchId String?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@unique([executionId, nodeId])
  @@index([organizationId, status])
  @@index([status, resumeAt])
}

model Form {
  id             String       @id @default(cuid())
  name           String
  config         String       @default("{}") // JSON string for form fields/styles
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Domain {
  id             String       @id @default(cuid())
  domain         String
  isVerified     Boolean      @default(false)
  spfRecord      String?
  dkimRecord     String?
  dmarcRecord    String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model ApiKey {
  id             String       @id @default(cuid())
  name           String
  key            String       @unique
  scopes         String       @default("[]") // JSON string of scopes
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  lastUsedAt     DateTime?
}

model AuditLog {
  id             String       @id @default(cuid())
  action         String
  entityType     String
  entityId       String
  userId         String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  timestamp      DateTime     @default(now())

  @@index([timestamp])
  @@index([entityType])
}

model CustomFieldDefinition {
  id             String       @id @default(cuid())
  name           String
  key            String
  type           String       @default("TEXT") // TEXT, NUMBER, DATE, BOOLEAN
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([key, organizationId])
}

model Asset {
  storageKey String?
  checksum   String?
  scanStatus String @default("LEGACY")
  @@index([organizationId, createdAt, id])
  @@index([organizationId, checksum])
  id             String       @id @default(cuid())
  name           String
  url            String
  type           String       @default("IMAGE") // IMAGE, VIDEO, DOCUMENT
  mimeType       String?
  size           Int?
  metadata       String? // JSON string for generation parameters
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model ValidationLog {
  id             String       @id @default(cuid())
  email          String
  status         String // VALID, INVALID, RISKY, UNKNOWN
  score          Int
  confidence     Float
  details        String       @default("{}") // JSON string
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
}

model BulkValidationJob {
  id             String                 @id @default(cuid())
  name           String?
  status         String                 @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  totalCount     Int                    @default(0)
  processedCount Int                    @default(0)
  validCount     Int                    @default(0)
  invalidCount   Int                    @default(0)
  riskyCount     Int                    @default(0)
  error          String?
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id])
  results        BulkValidationResult[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
}

model BulkValidationResult {
  id        String            @id @default(cuid())
  jobId     String
  job       BulkValidationJob @relation(fields: [jobId], references: [id])
  email     String
  status    String
  score     Int
  details   String            @default("{}")
  createdAt DateTime          @default(now())
}

model DomainIntelligence {
  id            String   @id @default(cuid())
  domain        String   @unique
  isDisposable  Boolean  @default(false)
  isRoleBased   Boolean  @default(false)
  isCatchAll    Boolean  @default(false)
  mxRecords     String   @default("[]") // JSON string
  lastCheckedAt DateTime @default(now())
}

model FormSubmission {
  id             String   @id @default(cuid())
  formId         String
  organizationId String
  payload        Json
  createdAt      DateTime @default(now())

  @@index([formId, createdAt])
  @@index([organizationId, createdAt])
}

model FormMetric {
  id             String   @id @default(cuid())
  formId         String   @unique
  organizationId String
  views          Int      @default(0)
  submissions    Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
}

model GrowthRewardTier {
  id             String   @id @default(cuid())
  organizationId String
  referrals      Int
  reward         String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, referrals])
  @@index([organizationId, active])
}

model GrowthReferral {
  id             String   @id @default(cuid())
  organizationId String
  referrerEmail  String
  referredEmail  String
  status         String   @default("ATTRIBUTED")
  verifiedAt     DateTime?
  verificationEmailStatus    String    @default("PENDING")
  verificationEmailSentAt    DateTime?
  verificationEmailAttempts  Int       @default(0)
  verificationEmailLastError String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, referredEmail])
  @@index([organizationId, referrerEmail])
  @@index([organizationId, status])
  @@index([organizationId, verificationEmailStatus])
}

model GrowthRewardClaim {
  id             String    @id @default(cuid())
  organizationId String
  rewardTierId   String
  referrerEmail  String
  referralCount  Int
  status         String    @default("ELIGIBLE")
  createdAt      DateTime  @default(now())
  claimedAt      DateTime?

  @@unique([organizationId, rewardTierId, referrerEmail])
  @@index([organizationId, status])
  @@index([organizationId, referrerEmail])
}
