{
  "name": "signal",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "NODE_ENV=development tsx server.ts",
    "db:sqlite": "prisma db push --schema=prisma/schema.sqlite.prisma",
    "build": "pnpm build:web && pnpm build:server",
    "build:web": "vite build",
    "build:server": "tsup server.ts --format esm --platform node --target node22 --out-dir dist-server --clean --sourcemap",
    "start": "node dist-server/server.js",
    "bootstrap:admin": "node scripts/bootstrap-admin.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "eslint src/ server.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "prepare": "husky || true",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:load": "node scripts/load-smoke.mjs",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
